# =============================================================================
# HomeFlix Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=HomeFlix
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8005
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./homeflix.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/homeflix

# -----------------------------------------------------------------------------
# Media Directories
# -----------------------------------------------------------------------------
# Comma-separated list of directories to scan for media files
MEDIA_DIRECTORIES=/path/to/movies,/path/to/series

# Where to store generated thumbnails
THUMBNAILS_DIRECTORY=./thumbnails

# Where mirrored catalog artwork is stored (ADR-029). A flat directory
# of content-addressed <hash>.<ext> image files, served via
# GET /api/v1/artwork/{key}. Use an absolute path on a persistent volume
# in production so mirrored images survive redeploys.
ARTWORK_STORAGE_DIRECTORY=./artwork

# -----------------------------------------------------------------------------
# HLS streaming cache
# -----------------------------------------------------------------------------
# Where the HLS service writes per-file segment buckets. The directory
# is created on first stream and grows as users play media.
HLS_CACHE_DIRECTORY=./hls_cache

# The cache cap (``hls_cache_max_size_mb``) moved to ``app_settings``
# in ADR-013 phase 3. Edit it via the admin panel; the legacy
# ``HLS_CACHE_MAX_SIZE_MB`` env var no longer takes effect.

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# TMDB - The Movie Database (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# OMDb - Open Movie Database (https://www.omdbapi.com/apikey.aspx)
# Optional: used as fallback when TMDB doesn't have data
OMDB_API_KEY=your_omdb_api_key_here

# -----------------------------------------------------------------------------
# Operational tunables (scheduler / backfill / intro / streaming / avatar)
# -----------------------------------------------------------------------------
# Moved to the ``app_settings`` table across ADR-013 phases 2 and 3.
# Edit them via the admin panel or:
#   UPDATE app_settings SET value_json='...' WHERE key='scheduler';
# The legacy ``SCHEDULER_*``, ``THUMBNAIL_BACKFILL_*``,
# ``INTRO_DETECTION_*``, ``FFMPEG_THREADS``, ``HLS_CACHE_MAX_SIZE_MB``
# and ``AVATAR_*`` env vars no longer take effect; startup logs a
# warning listing any still set.

# -----------------------------------------------------------------------------
# Internationalization
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt-BR

# -----------------------------------------------------------------------------
# Security (for future use)
# -----------------------------------------------------------------------------
# SECRET_KEY=your-secret-key-here-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Docker (docker-compose.yml)
# -----------------------------------------------------------------------------
# The container ignores APP_ENV, DATABASE_URL, MEDIA_DIRECTORIES and the
# directory settings above (they hold host paths for `make dev`). It reads
# these instead, plus SECRET_KEY, TMDB_*, OMDB_API_KEY, ALLOWED_ORIGINS and
# the locales.
#
# Required: host folder with the media library, mounted read-only at /media.
# MEDIA_ROOT=/srv/media
# HOMEFLIX_MEDIA_DIRECTORIES=/media/movies,/media/series
#
# Required: the container runs in production mode unless told otherwise.
# SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# Local run over plain HTTP:
# HOMEFLIX_APP_ENV=development
# HOMEFLIX_COOKIE_SECURE=false
#
# Optional:
# HOMEFLIX_DATA=./data        # database, thumbnails, artwork, HLS cache
# HOMEFLIX_BIND=127.0.0.1     # published on loopback; the reverse proxy is the way in
# HOMEFLIX_PORT=8005
# HOMEFLIX_LOG_LEVEL=INFO
# HOMEFLIX_DATABASE_URL=sqlite+aiosqlite:////app/data/homeflix.db
